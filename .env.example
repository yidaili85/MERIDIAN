# MERIDIAN 配置模板：复制为 .env 后填写。切勿提交 .env 到 Git。
# 容器 / 一键脚本都会读取这些变量。

# ---------- 必填 ----------
# 后台登录密码（/admin）。生成一个强密码：
#   openssl rand -base64 24
ADMIN_PASSWORD=

# ---------- 基础 ----------
HOST=0.0.0.0
PORT=3000
# 容器内固定为 /data；源码直跑默认 ./data
DATA_DIR=/data
# HTTPS 正式环境置 true；PUBLIC_BASE_URL 为 https 时会自动启用 Secure Cookie
COOKIE_SECURE=false
# 正式域名，必须 https 根域名、不带路径；设置后启用 canonical / sitemap / 支付回跳
# PUBLIC_BASE_URL=https://shop.example.com

# ---------- 支付 ----------
# PayPal REST App（Sandbox 或 Live）。三个都填齐才会在前台出现 PayPal。
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# on（默认）：普通订单只能 PayPal，含 VIP 商品的订单只能 USDT
# off：关闭该规则，已启用的方式都可选
PAYMENT_RULES=on

# ---------- 订单 ----------
# 未支付订单过期分钟数，0 = 关闭
ORDER_TTL_MINUTES=30
# 过期扫描间隔（毫秒）
SWEEP_INTERVAL_MS=300000

# ---------- 邮件通知（可选） ----------
# HTTP 邮件 API：resend / postmark / sendgrid / generic
# MAIL_PROVIDER=resend
# MAIL_API_KEY=
# MAIL_API_URL=               # generic 时必填
# SMTP：设为 smtp 后填写；远程认证默认强制 STARTTLS
# MAIL_PROVIDER=smtp
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=false      # 465 隐式 TLS 时改 true
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_SMTP_ALLOW_INSECURE=false  # 仅可信内网调试可改 true
# 两类邮件共用
# MAIL_FROM=orders@example.com
# MAIL_FROM_NAME=MERIDIAN
# ORDER_NOTIFY_EMAIL=owner@example.com
# WHATSAPP_NUMBER=+861****0000
